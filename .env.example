# Copy to `.env` and fill in. Precedence: configs/pipeline_config.yaml < environment < CLI flags.

# --- Credentials (never commit the real values) ---
OPENAI_API_KEY=sk-your-key-here
# Optional: Azure/OpenAI-compatible gateway or proxy.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Operational overrides (optional) ---
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
MAX_CONCURRENCY=8
# REQUESTS_PER_MINUTE=3000
# TOKENS_PER_MINUTE=1000000
# MAX_RETRY_ATTEMPTS=6
# BATCH_MAX_ITEMS=128

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FORMAT=json
